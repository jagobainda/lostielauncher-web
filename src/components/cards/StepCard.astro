---
import { Icon } from "astro-icon/components";

interface Props {
    step: number;
    icon: string;
    title: string;
    description: string;
}

const { step, icon, title, description } = Astro.props;
---

<li class="relative bg-(--bg-secondary) p-6 shadow-px" data-step-card>
    <span
        class="absolute top-4 right-5 font-display text-4xl leading-none font-bold text-(--overlay-muted)"
        aria-hidden="true"
    >
        {step}
    </span>
    <span class="flex size-12 items-center justify-center bg-(--bg-tertiary) text-(--accent) shadow-px-sm">
        <Icon name={icon} class="size-6" />
    </span>
    <h3 class="mt-5 font-pixel text-lg font-semibold">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-(--text-dim)">{description}</p>
</li>
