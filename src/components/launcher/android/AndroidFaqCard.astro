---
import Icon from "./AndroidIcon.astro";
import ReplicaLinkText from "../ReplicaLinkText.astro";

interface Props {
    question: string;
    answer: string;
}
const { question, answer } = Astro.props;
---

<details data-faq-card class="group mb-[10em] rounded-[8em] bg-(--lt-overlay-subtle)">
    <summary class="flex cursor-pointer list-none items-center gap-[10em] p-[16em] [&::-webkit-details-marker]:hidden">
        <Icon name="lucide:circle-question-mark" class="size-[16em] shrink-0 text-(color:--lt-primary-fg)" />
        <span data-faq-text class="min-w-0 flex-1 text-[14em] font-semibold">
            {question}
        </span>
        <Icon
            name="lucide:chevron-down"
            class="size-[16em] shrink-0 text-(color:--lt-secondary-fg-dim) group-open:rotate-180"
        />
    </summary>
    <div class="mx-[16em] h-[1em] bg-(--lt-overlay-light)"></div>
    <div class="px-[16em] pt-[12em] pb-[16em]">
        <p data-faq-text class="text-[13em] whitespace-pre-wrap text-(color:--lt-secondary-fg-dim)">
            <ReplicaLinkText platform="Android" text={answer} />
        </p>
    </div>
</details>
