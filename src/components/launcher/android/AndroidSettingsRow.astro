---
import Icon from "./AndroidIcon.astro";

interface Props {
    icon: string;
    label: string;
    divider?: boolean;
}
const { icon, label, divider = false } = Astro.props;
---

{divider && <div class="mx-[16em] h-[1em] bg-(--lt-overlay-light)"></div>}
<div class="flex items-center px-[16em] py-[14em]">
    <Icon name={icon} class="mr-[10em] size-[16em] shrink-0 text-(color:--lt-secondary-fg-dim)" />
    <div class="min-w-0 flex-1">
        <span class="text-[13em]">{label}</span>
    </div>
    <slot />
</div>
