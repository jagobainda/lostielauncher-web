---
import { getEntry } from "astro:content";
import type { Locale } from "../../../lib/i18n";
import { getCatalog, getHomeFeed } from "../../../lib/launcherCatalog";
import { DEFAULT_THEME, themeStyle } from "../../../lib/launcherReplica";
import DesktopShell from "./DesktopShell.astro";
import DesktopHomeView from "./DesktopHomeView.astro";
import DesktopGamesView from "./DesktopGamesView.astro";
import DesktopLibraryView from "./DesktopLibraryView.astro";
import DesktopFaqsView from "./DesktopFaqsView.astro";
import DesktopSettingsView from "./DesktopSettingsView.astro";

interface Props {
    locale: Locale;
    label: string;
}
const { locale, label } = Astro.props;
const [entry, games, feed] = await Promise.all([getEntry("launcherDesktop", locale), getCatalog(), getHomeFeed()]);
if (!entry) throw new Error(`Missing desktop launcher copy: ${locale}`);
const copy = entry.data;
---

<div
    data-replica
    data-desktop-replica
    data-theme={DEFAULT_THEME.name}
    role="group"
    aria-label={label}
    style={themeStyle(DEFAULT_THEME)}
    class="desktop-replica w-full max-w-[1000px] font-sans [container-type:inline-size]"
>
    <div class="text-[length:calc(100cqw/1000)] leading-[1.333333] text-left h-[650em] overflow-hidden border-[1em] border-(--lt-primary-fg) bg-(--lt-primary-bg) text-(color:--lt-secondary-fg)">
        <DesktopShell copy={copy}>
            <DesktopHomeView copy={copy} feed={feed} locale={locale} />
            <DesktopGamesView copy={copy} games={games} />
            <DesktopLibraryView copy={copy} games={games} />
            <DesktopFaqsView copy={copy} />
            <DesktopSettingsView copy={copy} locale={locale} />
        </DesktopShell>
    </div>
</div>

<script>
    import { initReplica } from "../../../scripts/launcherReplica";
    document.querySelectorAll<HTMLElement>("[data-desktop-replica]").forEach(initReplica);
</script>

<style>
    /* The landing's pixel icon rendering distorts the launcher's vector icons. */
    .desktop-replica :global(svg[data-icon]) {
        shape-rendering: geometricPrecision;
    }
</style>
