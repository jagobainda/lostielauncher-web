<div class="desktop-scroll h-full min-h-0 min-w-0 overflow-x-hidden overflow-y-auto">
    <slot />
</div>

<style>
    /* Native scrollbar styled like the WPF ModernVerticalScrollBar, so it can still be dragged */
    .desktop-scroll::-webkit-scrollbar {
        width: 12em;
    }
    .desktop-scroll::-webkit-scrollbar-track {
        border-left: 4em solid transparent;
        border-radius: 4em;
        background: var(--lt-overlay-subtle) padding-box;
    }
    .desktop-scroll::-webkit-scrollbar-thumb {
        border: 1em solid transparent;
        border-left-width: 5em;
        border-radius: 4em;
        background: var(--lt-overlay-strong) padding-box;
    }
    .desktop-scroll::-webkit-scrollbar-thumb:hover {
        background-color: var(--lt-primary-fg);
    }
    @supports not selector(::-webkit-scrollbar) {
        .desktop-scroll {
            scrollbar-width: thin;
            scrollbar-color: var(--lt-overlay-strong) var(--lt-overlay-subtle);
        }
    }
</style>
