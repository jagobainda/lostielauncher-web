---
import Icon from "./DesktopIcon.astro";
import { getLauncherReleases, formatDisplayVersion } from "../../../lib/launcher";
import type { DesktopCopy } from "../../../lib/types";
import { LOCALE_LABELS, type Locale } from "../../../lib/i18n";
import { DEFAULT_THEME } from "../../../lib/launcherReplica";
import DesktopScrollArea from "./DesktopScrollArea.astro";
import ReplicaThemeOptions from "../ReplicaThemeOptions.astro";
interface Props {
    copy: DesktopCopy;
    locale: Locale;
}
const { copy, locale } = Astro.props;
const releases = await getLauncherReleases();
const version = formatDisplayVersion(releases.Desktop.version);
const toggles = [
    { icon: "mdi:launch", label: copy.SettingsStartWithWindows },
    { icon: "mdi:window-minimize", label: copy.SettingsStartMinimized },
    { icon: "mdi:update", label: copy.SettingsAutoUpdate },
];
---

<div data-replica-view="settings" data-title={copy.TitleSettings} hidden class="h-full">
    <DesktopScrollArea>
        <div class="px-[20em] pt-[20em] pb-[4em]">
            <div class="mb-[8em] ml-[4em]">
                <span class="text-[14em] font-semibold text-(color:--lt-primary-fg)">{copy.SettingsGeneral}</span>
            </div>
            <div class="mb-[24em] rounded-[6em] bg-(--lt-secondary-bg)">
                {toggles.map(item => (
                    <>
                        <div class="mx-[16em] flex h-[52em] items-center justify-between">
                            <div class="flex items-center">
                                <Icon
                                    name={item.icon}
                                    class="mr-[10em] size-[16em] text-(color:--lt-secondary-fg-dim)"
                                />
                                <span class="text-[13em]">{item.label}</span>
                            </div>
                            <span class="flex h-[24em] w-[44em] items-center rounded-[12em] bg-(--lt-overlay-muted) px-[3em]">
                                <span class="size-[18em] rounded-[9em] bg-(--lt-secondary-fg)"></span>
                            </span>
                        </div>
                        <div class="mx-[16em] h-[1em] bg-(--lt-overlay-light)"></div>
                    </>
                ))}
                <div class="mx-[16em] flex items-center justify-between py-[14em]">
                    <div class="flex items-center">
                        <Icon name="mdi:refresh" class="mr-[10em] size-[16em] text-(color:--lt-secondary-fg-dim)" />
                        <span class="text-[13em]">{version}</span>
                    </div>
                    <span class="flex h-[32em] items-center rounded-[4em] bg-(--lt-overlay-muted) px-[12em] hover:bg-(--lt-overlay-medium) active:bg-(--lt-overlay-light)">
                        <span class="text-[12em]">{copy.SettingsCheckForUpdates}</span>
                    </span>
                </div>
                <div class="mx-[16em] h-[1em] bg-(--lt-overlay-light)"></div>
                <div class="px-[16em] py-[14em]">
                    <div class="mb-[10em] flex items-center">
                        <Icon
                            name="mdi:folder-download"
                            class="mr-[10em] size-[16em] text-(color:--lt-secondary-fg-dim)"
                        />
                        <span class="text-[13em]">{copy.SettingsDownloadDir}</span>
                    </div>
                    <div class="flex items-center gap-[8em]">
                        <span class="flex-1 rounded-[4em] bg-(--lt-tertiary-bg) px-[10em] py-[7em]">
                            <span class="text-[12em]">C:\Users\Player</span>
                        </span>
                        <span class="flex h-[32em] items-center rounded-[4em] bg-(--lt-overlay-muted) px-[12em] hover:bg-(--lt-overlay-medium) active:bg-(--lt-overlay-light)">
                            <span class="text-[12em]">{copy.BtnBrowse}</span>
                        </span>
                    </div>
                    <div class="mt-[8em] flex gap-[6em]">
                        <span class="text-[12em] text-(color:--lt-secondary-fg-dim)">{copy.SettingsGamesStoredIn}</span>
                        <span class="text-[12em]">C:\Users\Player\LostieLauncher</span>
                    </div>
                </div>
            </div>
            <div class="mb-[8em] ml-[4em]">
                <span class="text-[14em] font-semibold text-(color:--lt-primary-fg)">{copy.SettingsAppearance}</span>
            </div>
            <div class="rounded-[6em] bg-(--lt-secondary-bg)">
                <div class="mx-[16em] flex items-center justify-between py-[14em]">
                    <div class="flex items-center">
                        <Icon name="mdi:translate" class="mr-[10em] size-[16em] text-(color:--lt-secondary-fg-dim)" />
                        <span class="text-[13em]">{copy.SettingsLanguage}</span>
                    </div>
                    <span class="flex h-[34em] w-[160em] items-center justify-between rounded-[4em] bg-(--lt-tertiary-bg) pl-[10em] pr-[11em]">
                        <span class="text-[12em]">{LOCALE_LABELS[locale]}</span>
                        <span class="size-0 border-x-[4em] border-t-[4em] border-x-transparent border-t-(--lt-secondary-fg-dim)"></span>
                    </span>
                </div>
                <div class="mx-[16em] h-[1em] bg-(--lt-overlay-light)"></div>
                <div class="mx-[16em] flex items-center justify-between py-[14em]">
                    <div class="flex items-center">
                        <Icon name="mdi:palette" class="mr-[10em] size-[16em] text-(color:--lt-secondary-fg-dim)" />
                        <span class="text-[13em]">{copy.SettingsTheme}</span>
                    </div>
                    <details data-replica-theme-picker class="relative">
                        <summary
                            aria-label={copy.SettingsTheme}
                            class="flex h-[34em] w-[160em] cursor-pointer list-none [&::-webkit-details-marker]:hidden items-center justify-between rounded-[4em] bg-(--lt-tertiary-bg) pl-[10em] pr-[11em]"
                        >
                            <span data-replica-theme-name class="text-[12em]">
                                {DEFAULT_THEME.name}
                            </span>
                            <span class="size-0 border-x-[4em] border-t-[4em] border-x-transparent border-t-(--lt-secondary-fg-dim)"></span>
                        </summary>
                        <div class="absolute right-0 bottom-[36em] z-10 w-[160em] shadow-[0_2em_8em_var(--lt-popup-shadow)] rounded-[4em] bg-(--lt-secondary-bg) p-[4em]">
                            <ReplicaThemeOptions platform="Desktop" />
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </DesktopScrollArea>
</div>
