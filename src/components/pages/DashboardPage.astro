---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameStatsCard from "../cards/GameStatsCard.astro";
import LauncherStats from "../sections/LauncherStats.astro";
import UniqueUsers from "../sections/UniqueUsers.astro";
import Button from "../ui/Button.astro";
import { formatGeneratedAt, formatNumber, getDownloadStats, getMonthlyUsers } from "../../lib/stats";

const page = await getEntry("pages", "dashboard");
if (!page?.data.dashboard) {
    throw new Error('Missing dashboard copy — create src/content/pages/dashboard.json with a "dashboard" block');
}
const { title, description, noindex, dashboard } = page.data;

const [stats, monthlyUsers] = await Promise.all([getDownloadStats(), getMonthlyUsers()]);

const games = stats ? Object.entries(stats.byGame).sort(([, a], [, b]) => b.totalDownloads - a.totalDownloads) : [];
const gamesTotal = games.reduce((sum, [, game]) => sum + game.totalDownloads, 0);

const kpis = stats
    ? [
          {
              label: dashboard.kpis.gamesTotal,
              value: formatNumber(gamesTotal),
              icon: "pixelarticons:gamepad",
              href: "#games",
          },
          ...(monthlyUsers
              ? [
                    {
                        label: dashboard.kpis.uniqueUsers,
                        value: formatNumber(monthlyUsers.latest.users),
                        icon: "pixelarticons:users",
                        href: "#unique-users",
                    },
                ]
              : []),
          {
              label: dashboard.kpis.launcherTotal,
              value: formatNumber(stats.byLauncher.totalDownloads),
              icon: "pixelarticons:zap",
              href: "#launcher",
          },
      ]
    : [];
---

<BaseLayout title={title} description={description} lang="es" noindex={noindex}>
    <main class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6">
        <header data-dashboard-header>
            <a
                href="/"
                class="inline-flex min-h-11 items-center gap-2 font-pixel text-(--text-dim) underline decoration-2 underline-offset-4 transition-colors duration-75 ease-px hover:text-(--accent)"
                data-fade
            >
                <Icon name="pixelarticons:arrow-left" class="size-6" />
                {dashboard.backHome}
            </a>
            <div class="mt-6 flex items-center gap-4" data-fade>
                <img
                    src="/imgs/favicon/favicon.png"
                    alt=""
                    class="size-12 shrink-0 [image-rendering:pixelated]"
                    width="48"
                    height="48"
                />
                <h1 class="font-display text-2xl leading-tight font-bold tracking-[0.02em] uppercase sm:text-4xl">
                    {dashboard.heading}
                </h1>
            </div>
            <p class="mt-3 text-(--text-dim)" data-fade>
                {dashboard.subtitle}
            </p>
            {stats && (
                <p
                    class="mt-5 inline-flex items-center gap-2 bg-(--bg-tertiary) px-3 py-1 font-pixel text-sm text-(--text-dim) shadow-px-sm"
                    data-fade
                >
                    <Icon name="pixelarticons:clock" class="size-3" />
                    {dashboard.updatedPrefix} {formatGeneratedAt(stats.generatedAt)}
                </p>
            )}
        </header>

        {!stats && (
            <div class="mt-16 flex flex-col items-center gap-5 bg-(--bg-secondary) p-10 text-center shadow-px">
                <Icon name="pixelarticons:cloud" class="size-12 text-(--text-dim)" />
                <h2 class="font-display text-xl font-bold uppercase">{dashboard.error.heading}</h2>
                <p class="max-w-md text-sm text-(--text-dim)">{dashboard.error.message}</p>
                <Button href="/dashboard" variant="secondary">
                    <Icon name="pixelarticons:reload" class="size-6" />
                    {dashboard.error.retry}
                </Button>
            </div>
        )}

        {stats && (
            <>
                <ul
                    class:list={["mt-12 grid gap-8", kpis.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2"]}
                    data-kpis
                >
                    {kpis.map(kpi => (
                        <li data-kpi>
                            <a
                                href={kpi.href}
                                class="group flex h-full items-center gap-4 bg-(--bg-secondary) p-5 shadow-px transition-[translate,box-shadow,background-color] duration-75 ease-px hover:translate-1 hover:bg-(--bg-tertiary) hover:shadow-px-pressed"
                            >
                                <span class="flex size-12 shrink-0 items-center justify-center bg-(--bg-tertiary) text-(--accent) shadow-px-sm">
                                    <Icon name={kpi.icon} class="size-6" />
                                </span>
                                <span class="flex min-w-0 flex-col">
                                    <span class="font-display text-2xl font-bold">{kpi.value}</span>
                                    <span class="font-pixel text-(--text-dim)">{kpi.label}</span>
                                </span>
                                <Icon
                                    name="pixelarticons:chevron-right"
                                    class="ml-auto size-6 shrink-0 text-(--text-dim) group-hover:text-(--accent)"
                                />
                            </a>
                        </li>
                    ))}
                </ul>

                <section id="games" class="mt-16 scroll-mt-8" aria-labelledby="games-stats-heading">
                    <h2
                        id="games-stats-heading"
                        class="font-display text-2xl font-bold tracking-[0.04em] uppercase"
                        data-fade-in
                    >
                        {dashboard.games.heading}
                    </h2>
                    <ul class="mt-8 grid gap-8 md:grid-cols-2" data-game-cards>
                        {games.map(([slug, game]) => (
                            <GameStatsCard slug={slug} stats={game} copy={dashboard.games} />
                        ))}
                    </ul>
                </section>
            </>
        )}

        {monthlyUsers && <UniqueUsers stats={monthlyUsers} copy={dashboard.uniqueUsers} />}

        {stats && <LauncherStats stats={stats.byLauncher} copy={dashboard.launcher} />}
    </main>
</BaseLayout>

<script>
    import { fadeInOnScroll, staggerInOnScroll } from "../../scripts/animations";

    staggerInOnScroll("[data-dashboard-header]", "[data-fade]");
    staggerInOnScroll("[data-kpis]", "[data-kpi]");
    staggerInOnScroll("[data-game-cards]", "[data-stats-card]");
    fadeInOnScroll("[data-fade-in]");
</script>
