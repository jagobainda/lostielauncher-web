---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LangSwitcher from "../ui/LangSwitcher.astro";
import Hero from "../sections/Hero.astro";
import ScreenshotGallery from "../sections/ScreenshotGallery.astro";
import InstallSteps from "../sections/InstallSteps.astro";
import Footer from "../sections/Footer.astro";
import { LAUNCHER_PLATFORMS } from "../../lib/downloads";
import { landingAlternates, type Locale } from "../../lib/i18n";
import { getLauncherReleases } from "../../lib/launcher";
import { softwareApplicationSchema } from "../../lib/seo";
import { PLATFORM_STORAGE_KEY } from "../../scripts/platform";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;

const page = await getEntry("pages", locale);
if (!page?.data.landing) {
    throw new Error(`Missing landing copy — create src/content/pages/${locale}/index.json with a "landing" block`);
}
const { title, description, landing } = page.data;

const releases = await getLauncherReleases();
---

<BaseLayout
    title={title}
    description={description}
    lang={locale}
    alternates={landingAlternates()}
    jsonLd={softwareApplicationSchema({ description, inLanguage: locale, version: releases.Desktop.version })}
>
    {/* Inline in <head> so the platform is set before first paint */}
    <script is:inline slot="head" define:vars={{ storageKey: PLATFORM_STORAGE_KEY, platforms: LAUNCHER_PLATFORMS }}>
        let platform = null;
        try {
            platform = localStorage.getItem(storageKey);
        } catch {}
        if (!platforms.includes(platform)) platform = /android/i.test(navigator.userAgent) ? "Android" : "Desktop";
        document.documentElement.dataset.platform = platform;
    </script>
    <div data-locale={locale}>
        <div class="absolute top-4 right-4 z-50 sm:top-5 sm:right-6">
            <LangSwitcher currentLocale={locale} />
        </div>
        <main>
            <Hero hero={landing.hero} releases={releases} />
            <ScreenshotGallery screenshots={landing.screenshots} {locale} />
            <InstallSteps install={landing.install} releases={releases} />
        </main>
        <Footer footer={landing.footer} />
    </div>
</BaseLayout>

<script>
    import { redirectToPreferredLocale } from "../../scripts/lang";

    const locale = document.querySelector("[data-locale]")?.getAttribute("data-locale");
    if (locale) redirectToPreferredLocale(locale);
</script>
