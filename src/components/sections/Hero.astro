---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import PixelSprite from "../ui/PixelSprite.astro";
import PlatformOnly from "../ui/PlatformOnly.astro";
import PlatformSwitcher from "../ui/PlatformSwitcher.astro";
import { LAUNCHER_PLATFORMS } from "../../lib/downloads";
import { GITHUB_URL, type LauncherReleases } from "../../lib/launcher";
import { CLOUD, SPARK } from "../../lib/sprites";
import type { LandingData } from "../../lib/types";

interface Props {
    hero: LandingData["hero"];
    releases: LauncherReleases;
}

const { hero, releases } = Astro.props;

// Each spark gets its own period and a negative delay, so they start out of phase and keep drifting apart.
// Timing goes inline: the `animation` shorthand from animate-px-blink would reset a delay set by a class.
// Offsets are measured from the centre: from lg up the title stops growing, so the sparks hug it at any width.
// Only the two beside the logo show on small screens; the rest would land on the copy.
const SPARKS = [
    { scale: 3, duration: 1.3, delay: 0, class: "top-36 left-[calc(50%-11rem)] sm:left-[calc(50%-17rem)]" },
    { scale: 2, duration: 1.7, delay: -0.4, class: "top-28 left-[calc(50%+9rem)] sm:left-[calc(50%+15rem)]" },
    {
        scale: 2,
        duration: 1.1,
        delay: -0.9,
        class: "top-72 left-[calc(50%-28rem)] hidden lg:block xl:left-[calc(50%-31rem)]",
    },
    {
        scale: 3,
        duration: 1.9,
        delay: -1.3,
        class: "top-76 left-[calc(50%+26rem)] hidden lg:block xl:left-[calc(50%+29rem)]",
    },
    {
        scale: 2,
        duration: 1.5,
        delay: -0.2,
        class: "top-176 left-[calc(50%-30rem)] hidden lg:block xl:left-[calc(50%-33rem)]",
    },
    {
        scale: 3,
        duration: 1.2,
        delay: -0.7,
        class: "top-168 left-[calc(50%+28rem)] hidden lg:block xl:left-[calc(50%+31rem)]",
    },
];
---

<section id="download" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <PixelSprite sprite={CLOUD} scale={8} class="absolute top-24 -left-10 sm:left-[8%]" />
        <PixelSprite sprite={CLOUD} scale={6} class="absolute top-72 -right-16 sm:right-[6%]" />
        <PixelSprite sprite={CLOUD} scale={5} class="absolute top-120 left-[3%] hidden sm:block" />
        <PixelSprite sprite={CLOUD} scale={7} class="absolute right-[4%] bottom-20 hidden xl:block" />
        {SPARKS.map(spark => (
            <PixelSprite
                sprite={SPARK}
                scale={spark.scale}
                class={`absolute motion-safe:animate-px-blink ${spark.class}`}
                style={`animation-duration:${spark.duration}s;animation-delay:${spark.delay}s`}
            />
        ))}
    </div>

    <div
        class="mx-auto flex min-h-svh max-w-5xl flex-col items-center justify-center gap-[clamp(0.75rem,3svh,2.5rem)] px-4 py-8 text-center sm:px-6"
        data-hero
    >
        <div data-fade>
            <img
                src="/imgs/favicon/favicon.png"
                alt=""
                class="size-16 [image-rendering:pixelated] motion-safe:animate-px-bob sm:size-24 sm:short:size-16"
                width="96"
                height="96"
            />
        </div>

        <div>
            <h1
                class="font-display text-[clamp(2.5rem,min(11vw,11svh),7rem)] leading-none font-bold tracking-[0.02em] uppercase"
                data-fade
            >
                <span class="block text-(--accent)">Lostie</span>
                <span class="block">Launcher</span>
            </h1>
            <p class="mt-4 font-display text-base tracking-[0.06em] text-(--accent) uppercase sm:text-xl" data-fade>
                {hero.tagline}
            </p>
        </div>
        <p class="max-w-2xl leading-relaxed text-(--text-dim) max-sm:hidden short:hidden" data-fade>
            {LAUNCHER_PLATFORMS.map(platform => (
                <PlatformOnly platform={platform} as="span">
                    {hero.subtitle[platform]}
                </PlatformOnly>
            ))}
        </p>

        {LAUNCHER_PLATFORMS.map(platform => {
            const version = releases[platform].version;
            return (
                version && (
                    <PlatformOnly platform={platform}>
                        <p
                            class="inline-flex items-center gap-1.5 bg-(--bg-tertiary) px-3 py-1 font-display text-xs tracking-[0.04em] text-(--text-dim) uppercase shadow-px-sm"
                            data-fade
                        >
                            <Icon name="pixelarticons:label" class="size-3" />
                            {hero.versionPrefix} {version.replace(/^v/, "")}
                        </p>
                    </PlatformOnly>
                )
            );
        })}

        {/* z-10: the platform menu must cover the next faded-in siblings, whose transforms open stacking contexts */}
        <div class="relative z-10 flex w-full flex-col items-center justify-center gap-6 sm:flex-row" data-fade>
            <div class="flex w-full gap-1 sm:w-auto">
                <Button href="#install" variant="primary" class="flex-1 sm:flex-none">
                    <Icon name="pixelarticons:download" class="size-6" />
                    {LAUNCHER_PLATFORMS.map(platform => (
                        <PlatformOnly platform={platform} as="span">
                            {hero.installCta[platform]}
                        </PlatformOnly>
                    ))}
                </Button>
                <PlatformSwitcher label={hero.platformLabel} />
            </div>
            <Button
                href={GITHUB_URL}
                variant="secondary"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto"
            >
                <Icon name="pixelarticons:github" class="size-6" />
                {hero.githubCta}
            </Button>
        </div>
        <p class="font-pixel text-(--text-dim) max-sm:hidden" data-fade>
            {hero.downloadNote}
        </p>

        <ul class="grid w-full max-w-3xl grid-cols-2 gap-x-4 gap-y-5 sm:gap-x-6 md:grid-cols-4" data-fade>
            {hero.features.map(feature => (
                <li class="flex items-center gap-3 text-left sm:flex-col sm:text-center">
                    <span class="flex size-12 shrink-0 items-center justify-center bg-(--bg-tertiary) text-(--accent) shadow-px-sm">
                        <Icon name={feature.icon} class="size-6" />
                    </span>
                    <span class="font-pixel text-sm text-(--text-dim) sm:text-base">{feature.text}</span>
                </li>
            ))}
        </ul>
    </div>
</section>

<script>
    import { staggerInOnScroll } from "../../scripts/animations";

    staggerInOnScroll("[data-hero]", "[data-fade]");
</script>
