---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import PlatformOnly from "../ui/PlatformOnly.astro";
import StepCard from "../cards/StepCard.astro";
import { LAUNCHER_PLATFORMS } from "../../lib/downloads";
import type { LauncherReleases } from "../../lib/launcher";
import type { LandingData } from "../../lib/types";

interface Props {
    install: LandingData["install"];
    releases: LauncherReleases;
}

const { install, releases } = Astro.props;
---

<section id="install" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2
            class="text-center font-display text-2xl leading-tight font-bold tracking-[0.04em] uppercase sm:text-4xl"
            data-fade-in
        >
            {install.heading}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-(--text-dim)" data-fade-in>
            {install.subheading}
        </p>

        {LAUNCHER_PLATFORMS.map(platform => (
            <PlatformOnly platform={platform}>
                <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-steps={platform}>
                    {install.steps[platform].map((step, i) => (
                        <StepCard step={i + 1} icon={step.icon} title={step.title} description={step.description} />
                    ))}
                </ol>
            </PlatformOnly>
        ))}

        <p
            class="mx-auto mt-12 flex max-w-3xl items-start gap-3 bg-(--bg-tertiary) p-4 text-sm leading-relaxed text-(--text-dim) shadow-px-sm"
            data-fade-in
        >
            <Icon name="pixelarticons:info-box" class="size-6 shrink-0 text-(--accent)" />
            <span>
                {LAUNCHER_PLATFORMS.map(platform => (
                    <PlatformOnly platform={platform} as="span">
                        {install.note[platform]}
                    </PlatformOnly>
                ))}
            </span>
        </p>

        <div class="mt-14 text-center" data-fade-in>
            {LAUNCHER_PLATFORMS.map(platform => (
                <PlatformOnly platform={platform}>
                    <Button href={releases[platform].downloadUrl} variant="primary">
                        <Icon name="pixelarticons:download" class="size-6" />
                        {install.downloadCta[platform]}
                    </Button>
                </PlatformOnly>
            ))}
        </div>
    </div>
</section>

<script>
    import { fadeInOnScroll, staggerInOnScroll } from "../../scripts/animations";
    import { currentPlatform } from "../../scripts/platform";

    fadeInOnScroll("#install [data-fade-in]");
    // A hidden list never intersects, so only the visible platform's steps are held back for the reveal
    staggerInOnScroll(`[data-steps="${currentPlatform()}"]`, "[data-step-card]");
</script>
