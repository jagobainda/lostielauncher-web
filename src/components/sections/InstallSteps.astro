---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import StepCard from "../cards/StepCard.astro";
import { INSTALLER_URL } from "../../lib/launcher";
import type { LandingData } from "../../lib/types";

interface Props {
    install: LandingData["install"];
}

const { install } = Astro.props;
---

<section id="install" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2
            class="text-center font-display text-2xl leading-tight font-bold tracking-[0.04em] uppercase sm:text-4xl"
            data-fade-in
        >
            {install.heading}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-(--text-dim)" data-fade-in>
            {install.subheading}
        </p>

        <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-steps>
            {install.steps.map((step, i) => (
                <StepCard step={i + 1} icon={step.icon} title={step.title} description={step.description} />
            ))}
        </ol>

        <p
            class="mx-auto mt-12 flex max-w-3xl items-start gap-3 bg-(--bg-tertiary) p-4 text-sm leading-relaxed text-(--text-dim) shadow-px-sm"
            data-fade-in
        >
            <Icon name="pixelarticons:info-box" class="size-6 shrink-0 text-(--accent)" />
            <span>{install.smartScreenNote}</span>
        </p>

        <div class="mt-14 text-center" data-fade-in>
            <Button href={INSTALLER_URL} variant="primary">
                <Icon name="pixelarticons:download" class="size-6" />
                {install.downloadCta}
            </Button>
        </div>
    </div>
</section>

<script>
    import { fadeInOnScroll, staggerInOnScroll } from "../../scripts/animations";

    fadeInOnScroll("#install [data-fade-in]");
    staggerInOnScroll("[data-steps]", "[data-step-card]");
</script>
