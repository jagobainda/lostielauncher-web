---
import { LAUNCHER_PLATFORMS } from "../../lib/downloads";
import { DEFAULT_THEME, LAUNCHER_THEMES, themeStyle } from "../../lib/launcherReplica";
import type { Locale } from "../../lib/i18n";
import type { LandingData } from "../../lib/types";
import AndroidReplica from "../launcher/android/AndroidReplica.astro";
import DesktopReplica from "../launcher/desktop/DesktopReplica.astro";
import PlatformOnly from "../ui/PlatformOnly.astro";

interface Props {
    screenshots: LandingData["screenshots"];
    locale: Locale;
}

const { screenshots, locale } = Astro.props;
const replicas = { Desktop: DesktopReplica, Android: AndroidReplica };
---

<section id="screenshots" class="border-y-4 border-(--ink) bg-(--bg-secondary) py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2
            class="text-center font-display text-2xl leading-tight font-bold tracking-[0.04em] uppercase sm:text-4xl"
            data-fade-in
        >
            {screenshots.heading}
        </h2>
        <p class="mt-4 text-center text-sm text-(--text-dim)" data-fade-in>
            {screenshots.hint}
        </p>

        <div class="mt-12" data-gallery data-fade-in>
            {LAUNCHER_PLATFORMS.map(platform => {
                const Replica = replicas[platform];
                return (
                    <PlatformOnly platform={platform}>
                        <div
                            class:list={[
                                "mx-auto mb-3",
                                platform === "Desktop"
                                    ? "w-full shadow-px"
                                    : "w-[293px] max-w-full shadow-[8px_8px_0_0_var(--ink)]",
                            ]}
                        >
                            <Replica {locale} label={screenshots.label[platform]} />
                        </div>
                    </PlatformOnly>
                );
            })}

            <div class="mt-10 flex flex-wrap justify-center gap-3" role="group">
                {LAUNCHER_THEMES.map(theme => (
                    <button
                        type="button"
                        data-gallery-thumb
                        data-theme={theme.name}
                        data-theme-style={themeStyle(theme)}
                        aria-pressed={theme === DEFAULT_THEME ? "true" : "false"}
                        class="min-h-11 cursor-pointer bg-(--bg-tertiary) px-4 py-1.5 font-pixel text-(--text-dim) shadow-px-sm transition-colors duration-75 ease-px hover:bg-(--ink) hover:text-(--text-color) aria-pressed:bg-(--accent) aria-pressed:text-white"
                    >
                        {theme.name}
                    </button>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, steps } from "animejs";
    import { fadeInOnScroll, motionOK } from "../../scripts/animations";
    import { applyReplicaTheme, THEME_EVENT } from "../../scripts/launcherReplica";

    fadeInOnScroll("#screenshots [data-fade-in]");

    const root = document.querySelector<HTMLElement>("[data-gallery]");
    const replicas = root ? [...root.querySelectorAll<HTMLElement>("[data-replica]")] : [];
    const thumbs = root ? [...root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")] : [];

    if (root && replicas.length && thumbs.length) {
        let current = 0;
        let transition: ReturnType<typeof animate> | undefined;
        let timer: ReturnType<typeof setInterval> | null = null;
        let stopped = !motionOK();

        const cancelFade = () => {
            transition?.pause();
            replicas.forEach(replica => replica.style.removeProperty("opacity"));
        };
        const swap = (index: number) => {
            const thumb = thumbs[index];
            if (!thumb?.dataset.theme || !thumb.dataset.themeStyle) return;
            current = index;
            thumbs.forEach((button, i) => button.setAttribute("aria-pressed", String(i === index)));
            replicas.forEach(replica => {
                if (replica.dataset.theme !== thumb.dataset.theme) {
                    applyReplicaTheme(replica, thumb.dataset.theme!, thumb.dataset.themeStyle!);
                }
            });
        };
        const stopRotation = () => {
            stopped = true;
            if (timer) clearInterval(timer);
            timer = null;
            cancelFade();
        };
        const rotate = () => {
            if (!motionOK()) {
                stopRotation();
                return;
            }
            const index = (current + 1) % thumbs.length;
            transition = animate(replicas, {
                opacity: [1, 0],
                duration: 160,
                ease: steps(4),
                onComplete: () => {
                    swap(index);
                    transition = animate(replicas, { opacity: [0, 1], duration: 240, ease: steps(4) });
                },
            });
        };

        root.addEventListener(THEME_EVENT, event => {
            const name = (event as CustomEvent<{ name: string }>).detail.name;
            const index = thumbs.findIndex(thumb => thumb.dataset.theme === name);
            if (index >= 0 && index !== current) {
                cancelFade();
                swap(index);
            }
        });
        for (const event of ["pointerdown", "keydown", "focusin"]) {
            root.addEventListener(event, stopRotation, { once: true });
        }
        thumbs.forEach((thumb, index) =>
            thumb.addEventListener("click", () => {
                stopRotation();
                swap(index);
            }),
        );
        const io = new IntersectionObserver(
            entries => {
                const visible = entries.some(entry => entry.isIntersecting);
                if (visible && !stopped && !timer) {
                    timer = setInterval(rotate, 5000);
                } else if (!visible && timer) {
                    clearInterval(timer);
                    timer = null;
                }
            },
            { threshold: 0.3 },
        );
        io.observe(root);
        window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", event => {
            if (event.matches) stopRotation();
        });
    }
</script>
