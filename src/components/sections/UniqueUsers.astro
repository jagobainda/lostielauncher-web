---
import { Icon } from "astro-icon/components";
import type { LauncherPlatform } from "../../lib/downloads";
import { LAUNCHER_PLATFORMS } from "../../lib/downloads";
import type { MonthlyUsersStats } from "../../lib/stats";
import { formatNumber } from "../../lib/stats";
import type { DashboardData } from "../../lib/types";
import MonthlyBars from "../ui/MonthlyBars.astro";
import TabPanel from "../ui/TabPanel.astro";
import Tabs from "../ui/Tabs.astro";

interface Props {
    stats: MonthlyUsersStats;
    copy: DashboardData["uniqueUsers"];
    platforms: Record<LauncherPlatform, { label: string }>;
}

const { stats, copy, platforms } = Astro.props;

const highlights = [
    { label: copy.latestLabel, value: stats.latest.users, hint: stats.latest.label },
    { label: copy.averageLabel, value: stats.average, hint: stats.averageYear },
    { label: copy.peakLabel, value: stats.peak.users, hint: stats.peak.label },
];

const views = [
    { key: "all", label: copy.allLabel, points: stats.points },
    ...LAUNCHER_PLATFORMS.flatMap(key => {
        const points = stats.byPlatform[key];
        return points ? [{ key: key.toLowerCase(), label: platforms[key].label, points }] : [];
    }),
];
const hasTabs = views.length > 1;
---

<section id="unique-users" class="mt-16 scroll-mt-8" aria-labelledby="unique-users-heading">
    <h2 id="unique-users-heading" class="font-display text-2xl font-bold tracking-[0.04em] uppercase" data-fade-in>
        {copy.heading}
    </h2>
    <p class="mt-3 text-sm text-(--text-dim)" data-fade-in>
        {copy.subtitle}
    </p>

    <div class="mt-8 bg-(--bg-secondary) p-6 shadow-px" data-fade-in>
        <ul class="grid gap-5 sm:grid-cols-3">
            {highlights.map(item => (
                <li class="flex flex-col">
                    <span class="font-display text-3xl font-bold" data-count-up={item.value}>
                        {formatNumber(item.value)}
                    </span>
                    <span class="mt-1 font-pixel text-(--text-dim)">{item.label}</span>
                    <span class="font-display text-xs text-(--text-dim) uppercase">{item.hint}</span>
                </li>
            ))}
        </ul>

        <div class="mt-8 border-t-3 border-dotted border-(--overlay-muted) pt-6">
            <h3 class="mb-4 flex items-center gap-2 font-display text-xs tracking-[0.04em] text-(--text-dim) uppercase">
                <Icon name="pixelarticons:users" class="size-3" />
                {copy.chartLabel}
            </h3>
            {hasTabs && <Tabs id="unique-users" label={copy.filterLabel} tabs={views} />}
            {views.map((view, i) => (
                <TabPanel id="unique-users" tab={view.key} tabbed={hasTabs} hidden={i > 0}>
                    <MonthlyBars
                        points={view.points}
                        label={hasTabs ? `${copy.chartLabel} — ${view.label}` : copy.chartLabel}
                        unitLabel={copy.usersLabel}
                    />
                </TabPanel>
            ))}
            {hasTabs && <p class="mt-4 text-xs text-(--text-dim)">{copy.platformsNote}</p>}
        </div>
    </div>
</section>
