---
import { Icon } from "astro-icon/components";
import type { CountryStat, OsStat } from "../../lib/stats";
import { formatNumber, countryCode, osIcon } from "../../lib/stats";

type Props = { label: string } & ({ kind: "country"; items: CountryStat[] } | { kind: "os"; items: OsStat[] });

const props = Astro.props;
const { label } = props;

interface Row {
    name: string;
    count: number;
    percent: number;
    flag: string | null;
    icon: string | null;
}

const rows: Row[] =
    props.kind === "country"
        ? props.items.map(item => ({
              name: item.country,
              count: item.count,
              percent: item.percent,
              flag: countryCode(item.country),
              icon: null,
          }))
        : props.items.map(item => ({
              name: item.os,
              count: item.count,
              percent: item.percent,
              flag: null,
              icon: osIcon(item.os),
          }));

const max = Math.max(...rows.map(row => row.count), 1);

// Bars fill whole blocks only, like a segmented health bar
const SEGMENTS = 10;
const filledWidth = (count: number) => `${(Math.round((count / max) * SEGMENTS) / SEGMENTS) * 100}%`;
---

<ul class="space-y-1.5" aria-label={label}>
    {rows.map(row => (
        <li class="flex items-center gap-3 text-sm">
            <span class="flex w-24 shrink-0 items-center gap-2 truncate" title={row.name}>
                {row.flag && (
                    <img
                        src={`https://flagcdn.com/16x12/${row.flag}.png`}
                        srcset={`https://flagcdn.com/32x24/${row.flag}.png 2x, https://flagcdn.com/48x36/${row.flag}.png 3x`}
                        width="16"
                        height="12"
                        alt=""
                        loading="lazy"
                        class="shrink-0 [image-rendering:pixelated]"
                    />
                )}
                {row.icon && <Icon name={row.icon} class="size-6 shrink-0 text-(--text-dim)" />}
                <span class="truncate">{row.name}</span>
            </span>
            <span class="h-3 flex-1 bg-(--overlay-subtle)" style={`--segments:${SEGMENTS}`} data-segmented>
                <span class="block h-full bg-(--chart-1)" style={`width:${filledWidth(row.count)}`} />
            </span>
            <span class="w-12 shrink-0 text-right tabular-nums" data-count-up={row.count}>
                {formatNumber(row.count)}
            </span>
            <span class="w-12 shrink-0 text-right text-xs text-(--text-dim) tabular-nums">
                {row.percent.toFixed(1)}%
            </span>
        </li>
    ))}
</ul>

<style>
    /* Cuts the track into equal blocks with 2px gaps; a mask keeps both the empty and filled parts in step */
    [data-segmented] {
        mask: repeating-linear-gradient(
            90deg,
            #000 0 calc(100% / var(--segments) - 2px),
            transparent 0 calc(100% / var(--segments))
        );
    }
</style>
