---
interface Props {
    href: string;
    variant?: "primary" | "secondary";
    target?: string;
    rel?: string;
    class?: string;
}

const { href, variant = "primary", target, rel, class: className = "" } = Astro.props;

// Hover "presses" the button 4px into its stepped shadow, in a single frame
const base =
    "inline-flex min-h-14 items-center justify-center gap-2.5 px-7 py-3 font-pixel text-lg font-semibold shadow-px-btn transition-[translate,box-shadow,background-color] duration-75 ease-px hover:translate-1 hover:shadow-px-btn-pressed active:translate-1 active:shadow-px-btn-pressed";
const variants = {
    primary: "bg-(--accent) text-white hover:bg-(--accent-hover) active:bg-(--accent-pressed)",
    secondary: "bg-(--bg-tertiary) text-(--text-color) hover:bg-(--ink)",
};
---

<a href={href} target={target} rel={rel} class={`${base} ${variants[variant]} ${className}`}>
    <slot />
</a>
