---
import type { DonutSlice } from "../../lib/charts";
import { formatNumber } from "../../lib/stats";

interface Props {
    slices: DonutSlice[];
    total: number;
    grid: number;
    centerLabel: string;
    legendLabel: string;
}

const { slices, total, grid, centerLabel, legendLabel } = Astro.props;

const segLabel = (slice: DonutSlice) => `${slice.label}: ${formatNumber(slice.value)} (${slice.percent.toFixed(1)}%)`;
---

<div class="flex flex-wrap items-center gap-x-6 gap-y-4" data-donut-root>
    <div class="relative shrink-0">
        <svg
            width={grid * 4}
            height={grid * 4}
            viewBox={`0 0 ${grid} ${grid}`}
            shape-rendering="crispEdges"
            role="img"
            aria-label={legendLabel}
            class="block"
        >
            {slices.map((slice, i) =>
                slice.cells === "" ? null : (
                    <path
                        d={slice.cells}
                        fill={slice.color}
                        tabindex="0"
                        role="graphics-symbol"
                        aria-label={segLabel(slice)}
                        data-seg
                        data-index={i}
                        data-label={slice.label}
                        data-value={formatNumber(slice.value)}
                        data-percent={slice.percent.toFixed(1)}
                    />
                ),
            )}
        </svg>
        <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center">
            <span class="font-display text-base font-bold">{formatNumber(total)}</span>
            <span class="max-w-20 font-pixel text-xs leading-tight text-(--text-dim)">{centerLabel}</span>
        </div>
    </div>

    <ul class="grow basis-40 space-y-1" aria-label={legendLabel}>
        {slices.map((slice, i) => (
            <li class="flex items-center gap-2 px-1.5 py-0.5 text-sm" data-legend-row data-index={i}>
                <span class="size-3 shrink-0" style={`background:${slice.color}`} aria-hidden="true" />
                <span class="truncate">{slice.label}</span>
                <span class="ml-auto shrink-0 tabular-nums">{formatNumber(slice.value)}</span>
                <span class="w-12 shrink-0 text-right text-xs text-(--text-dim) tabular-nums">
                    {slice.percent.toFixed(1)}%
                </span>
            </li>
        ))}
    </ul>
</div>

<style>
    [data-seg] {
        outline: none;
        cursor: default;
    }
    [data-seg]:hover,
    [data-seg]:focus-visible {
        filter: brightness(1.15);
    }
    /* SVG paths ignore outline, so the focused slice gets a pixel-thin stroke instead */
    [data-seg]:focus-visible {
        stroke: var(--text-color);
        stroke-width: 0.5;
    }
    [data-seg].donut-dim {
        opacity: 0.35;
    }
    [data-legend-row].legend-active {
        background: var(--ink);
    }
</style>

<script>
    import { initDonutCharts } from "../../scripts/charts";

    initDonutCharts();
</script>
